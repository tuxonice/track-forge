{
    "name": "tuxonice/pixel-track",
    "version": "v0.4.0",
    "keywords": [
        "PHP",
        "gpx",
        "framework"
    ],
    "authors": [
        {
            "name": "Helder Correia",
            "email": "tuxboy@tlab.pt"
        }
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "sibyx/phpgpx": "1.3.0",
        "ext-json": "*",
        "ext-intl": "*",
        "symfony/http-foundation": "7.4.19",
        "twig/twig": "3.29.0",
        "symfony/console": "7.4.19",
        "ext-sqlite3": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "symfony/cache": "7.4.19",
        "symfony/uid": "7.4.17",
        "symfony/http-client": "7.4.19",
        "doctrine/dbal": "^4.4",
        "ext-simplexml": "*",
        "symfony/mime": "7.4.19",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "7.4.19",
        "symfony/runtime": "7.4.14",
        "symfony/twig-bundle": "7.4.19",
        "symfony/security-bundle": "7.4.18",
        "symfony/monolog-bundle": "^4.1",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/mailer": "7.4.19",
        "symfony/rate-limiter": "7.4.18",
        "symfony/dotenv": "7.4.18",
        "symfony/yaml": "7.4.18",
        "symfony/translation": "7.4.17"
    },
    "require-dev": {
        "symfony/var-dumper": "6.4.45",
        "squizlabs/php_codesniffer": "4.0.4",
        "phpstan/phpstan": "2.2.16",
        "phpstan/phpstan-doctrine": "2.0.28",
        "symfony/phpunit-bridge": "8.1.6",
        "symfony/browser-kit": "7.4.17",
        "symfony/css-selector": "7.4.18"
    },
    "scripts": {
        "copy-assets": [
            "php bin/copy-assets.php"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    }
}
