{% extends "Default/base.html.twig" %}

{% block title %}{{ 'route.title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css"
          integrity="sha512-xodZBNTC5n17Xt2atTPuE1HxjVMSvLVW9ocqUKLsCC5CXdbqCmblAshOMAS6/keqq/sMZMZ19scR4PsZChSR7A=="
          crossorigin=""/>
    <style>
        .route-legend {
            background: #fff;
            padding: 8px 12px;
            border-radius: 4px;
            box-shadow: 0 1px 5px rgba(0, 0, 0, .4);
            font: 14px/1.6 sans-serif;
        }

        .route-legend-swatch {
            display: inline-block;
            width: 14px;
            height: 4px;
            vertical-align: middle;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3">{{ 'route.title'|trans }}</h1>
            <p class="text-muted">{{ 'route.intro'|trans }}</p>
        </div>
    </div>

    {% if route is null %}
        <div class="alert alert-info">{{ 'route.none_found'|trans }}</div>
    {% else %}
        <div class="row mb-4" data-route-card>
            <div class="col-12">
                <div class="card border shadow-sm">
                    <div class="card-body">
                        <div id="route-map" class="rounded mb-3" style="height: 420px;"></div>
                        <span class="stat-pill">{{ route.distanceKm|number_format(2, '.', ',') }} Km</span>
                        <span class="stat-pill stat-pill-elevation">{{ route.elevation|number_format(0, '.', ',') }} m</span>
                        <p class="mt-3 mb-0">{{ 'route.uses'|trans }} {{ route.trackNames|join(', ') }}</p>
                    </div>
                    <div class="card-footer">
                        <form method="post" action="{{ path('app_route_save') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('route-save') }}"/>
                            {% for key in trackKeys %}
                                <input type="hidden" name="trackKeys[]" value="{{ key }}"/>
                            {% endfor %}
                            <button type="submit" class="btn btn-primary">{{ 'route.save'|trans }}</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <a href="{{ path('app_tracks') }}" class="btn btn-secondary">
        <i class="bi bi-list"></i> {{ 'track.back_to_list'|trans }}
    </a>
{% endblock %}

{% block javascripts %}
    {% if route is not null %}
    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"
            integrity="sha512-XQoYMqMTK8LvdxXYG3nZ448hOEQiglfqkJs1NOQV44cWnUrBc8PkAOcXy20w0vlaXaVUearIOBhiXZ5V3ynxwA=="
            crossorigin=""></script>
    <script>
        const route = {{ {latLngs: route.latLngs}|json_encode|raw }};
        const sources = {{ sources|json_encode|raw }};
        const resultColor = '#ff7a00';
        const sourceColors = ['#1f78ff', '#1a9850', '#8e44ad', '#d62728', '#17a2b8', '#8c564b'];

        const map = L.map('route-map');
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);

        // Source tracks underneath, the suggested route on top and thicker.
        const bounds = L.latLngBounds([]);
        sources.forEach(function (source, index) {
            source.color = sourceColors[index % sourceColors.length];
            bounds.extend(L.polyline(source.latLngs, {color: source.color, weight: 3, opacity: 0.8}).addTo(map).getBounds());
        });
        bounds.extend(L.polyline(route.latLngs, {color: resultColor, weight: 6}).addTo(map).getBounds());
        map.fitBounds(bounds);

        const legend = L.control({position: 'topright'});
        legend.onAdd = function () {
            const div = L.DomUtil.create('div', 'route-legend');
            const entries = [{name: {{ 'route.legend_result'|trans|json_encode|raw }}, color: resultColor}].concat(sources);
            entries.forEach(function (entry) {
                const row = document.createElement('div');
                const swatch = document.createElement('span');
                swatch.className = 'route-legend-swatch';
                swatch.style.background = entry.color;
                row.append(swatch, document.createTextNode(' ' + entry.name));
                div.append(row);
            });
            return div;
        };
        legend.addTo(map);
    </script>
    {% endif %}
{% endblock %}
