# WARNING: dev mode enables Symfony's full debug/stack-trace error page on any uncaught
# error, and exposes the /_error/{code} preview routes. Self-hosted PRODUCTION deployments
# MUST override this to APP_ENV=prod (e.g. via your own `.env` or a real environment
# variable) before going live — otherwise error pages will leak stack traces and internals
# instead of the themed error pages this app ships with.
APP_ENV=dev

# Symfony rejects requests whose Host header doesn't match one of these regex patterns —
# this is what makes generated absolute URLs safe against Host-header spoofing. Update
# this before deploying anywhere beyond local dev.
SYMFONY_TRUSTED_HOSTS='^localhost$'

# If this app runs behind a reverse proxy (nginx/Caddy/Traefik terminating TLS in front of
# this container), set this to the proxy's IP address (or a CIDR range, or "REMOTE_ADDR" to
# trust whichever host connects directly) so Symfony trusts its X-Forwarded-* headers for
# HTTPS detection, real client IP (used by the login-code rate limiters and country
# restriction), and session cookie security. Leave empty if there's no proxy in front of
# this container (e.g. local Docker dev).
SYMFONY_TRUSTED_PROXIES=""

# WARNING: this is Symfony's general application secret (CSRF tokens, signed values,
# among other things).
# The value below is freshly generated for this repository, but since .env.dist is
# committed and public, treat it as already-compromised too — every self-hoster MUST
# generate their own unique value before deploying (e.g. `php -r "echo bin2hex(random_bytes(16));"`)
# and set it in their own `.env`, never commit a real production secret here.
APP_SECRET='4acf543739132f9f28f00a001f281d78'

TIMEZONE='Europe/Lisbon'
BASE_URL="http://localhost"
# Used by config/packages/routing.yaml to generate URLs in non-HTTP contexts (e.g. bin/console)
DEFAULT_URI="http://localhost"

DATABASE_URL="sqlite:///%kernel.project_dir%/var/database/database.sqlite"

# Display name only matters for the "carob+api" transport below (its API has no "from"
# email field — the actual sending address is whatever that Carob Mailer instance is
# configured with — but it does require a non-empty display name).
EMAIL_FROM="TrackForge <user@example.com>"

# Default dev transport: the included Mailpit container (see docker-compose.yml), caught at
# http://localhost:8125/ instead of actually being delivered.
#
# To send through a Carob Mailer instance (https://github.com/tuxonice/carob-mailer) instead:
#   MAILER_DSN=carob+api://API_TOKEN@HOST[:PORT][?http_scheme=http&path=/mailer/send]
# "http_scheme" defaults to https; "path" defaults to "/api/mailer/send" (Laravel's
# withRouting(api: ...) mounts routes/api.php under "/api" by default) — override "path" if
# a given instance is deployed so that prefix isn't there (e.g. a reverse proxy strips it).
MAILER_DSN=smtp://mailpit:1025

RATE_LIMITER_REFILL_PERIOD=50
RATE_LIMITER_MAX_CAPACITY=5

LOGIN_TOLERANCE_TIME=300

PAGINATION_IPP=10

ALLOW_COUNTRY_CODE=""

# Where uploaded GPX files are stored, as a path relative to the project root.
UPLOAD_DATA_SUBDIR=var/data
